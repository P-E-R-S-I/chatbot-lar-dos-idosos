# Configure estes valores no painel Netlify, com acesso ao runtime Functions.
# Para desenvolvimento, copie este modelo para .env na raiz (não versionado).
GROQ_API_KEY=
SUPABASE_URL=
SUPABASE_KEY=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_VERIFY_TOKEN=
META_APP_SECRET=
# Versão da Graph API habilitada no app, no formato vNN.0.
WHATSAPP_API_VERSION=
# Opcional: telefone, URL ou orientação pública real para atendimento humano.
# Sem este valor, o bot orienta a consultar os contatos oficiais do Albergue.
WHATSAPP_HUMAN_CONTACT=
# Opcional: origens do frontend separadas por vírgula; mesma origem funciona sem preencher.
CORS_ORIGINS=
# Opcional: URL pública HTTPS deste MESMO site para invocar a função background.
# Por padrão é usada a URL de deploy fornecida pelo Netlify no contexto.
# No netlify dev: http://localhost:8888.
WHATSAPP_FUNCTION_BASE_URL=
# Reservado para as rotas de equipe quando houver armazenamento compartilhado.
WHATSAPP_ADMIN_TOKEN=
